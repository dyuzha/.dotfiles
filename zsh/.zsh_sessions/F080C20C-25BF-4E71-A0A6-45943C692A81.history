test_cases = [\
    'list(простой текст)',\
    'list(текст с, запу�ту�ми)',\
    'list(  текст с пробелами  )',\
    'list(сложну�й: текст, с разну�ми; символами!)',\
    'list()',  # пу�стое содержимое\
    'some text list(ну�жное содержимое) more text',\
]\
\
pattern = r'list\(\s*(.*?)\s*\)'\
\
for text in test_cases:\
    match = re.search(pattern, text)\
